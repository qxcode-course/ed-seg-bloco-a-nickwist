            "label": "2026-06-29_00-44-11",
            "content": "package main\n\nimport (\n\t\"fmt\"\n)\n\n// mostra a lista com o elemento sword destacado\nfunc ToStr(l *DList[int], sword *DNode[int]) string {\n\ttxt := \"\"\n\t\ttxt += \"[ \"\n\n\t\tnode := l.Front()\n\n\t\tfor i := 0; i < l.Size(); i++ {\n\t\t\tif node == sword {\n\t\t\t\ttxt += fmt.Sprintf(\"%d> \", node.Value)\n\t\t\t} else {\n\t\t\t\ttxt += fmt.Sprintf(\"%d \", node.Value)\n\t\t\t}\n\n\t\tnode = Next(l, node)\t\n\t\t}\n\ttxt += \"]\"\n\n\treturn txt\n}\n\n// move para frente na lista circular\nfunc Next(l *DList[int], it *DNode[int]) *DNode[int] {\n\tif it == nil || l.Size() == 0 {\n\t\treturn nil\n\t}\n\n\tif it.next == it.root {\n\t\treturn l.Front()\n\t}\n\n\treturn it.next\n}\n\nfunc main() {\n\tvar qtd, chosen int\n\tfmt.Scan(&qtd, &chosen)\n\tl := NewDList[int]()\n\tfor i := 1; i <= qtd; i++ {\n\t\tl.PushBack(i)\n\t}\n\tsword := l.Front()\n\tfor range chosen - 1 {\n\t\tsword = Next(l, sword)\n\t}\n\tfor range qtd - 1 {\n\t\tfmt.Println(ToStr(l, sword))\n\t\tl.Erase(Next(l, sword))\n\t\tsword = Next(l, sword)\n\t}\n\tfmt.Println(ToStr(l, sword))\n}\n",
