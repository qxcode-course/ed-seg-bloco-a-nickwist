            "content": "package main\n\nimport \"fmt\"\n\n// x: n\u00famero que est\u00e1 sendo testado\n// div: divisor que est\u00e1 sendo testado\nfunc eh_primo(x int, div int) bool {\n\n\tif x < 2 {\n\t\treturn false\n\t}\n\n\tif div == x {\n\t\treturn true\n\t}\n\n\tif x%2 == 0 {\n\t\treturn false\n\t}\n\n\tif eh_primo(x, div+1) {\n\t\treturn true\n\t}\n\n\treturn false\n}\n\nfunc main() {\n\tvar x int\n\tfmt.Scan(&x)\n\tif eh_primo(x, 2) {\n\t\tfmt.Println(\"true\")\n\t} else {\n\t\tfmt.Println(\"false\")\n\t}\n}\n",
